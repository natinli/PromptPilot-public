{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "PromptPilot",
  "version": "0.3.9",
  "identifier": "com.promptpilot.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*",
          "$APPDATA/images/**/*"
        ]
      }
    },
    "windows": [
      {
        "title": "PromptPilot",
        "label": "main",
        "width": 360,
        "height": 533,
        "minWidth": 280,
        "minHeight": 400,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "icons/icon.png": "icons/icon.png",
      "icons/icon.ico": "icons/icon.ico"
    },
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "displayLanguageSelector": false,
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/white-sidebar.bmp"
      }
    }
  }
}
